# Copy this file to itdk_mcp_credentials.env, replace the example key, and
# export the same values into the shell that starts Jupyter or Python clients.
MCP_MASTER_KEY=replace-with-a-long-random-classroom-key
MCP_PORT=8000
ITDK_MCP_URL=http://127.0.0.1:8000/mcp/sse
ITDK_OUTPUT_DIR=./outputs
ITDK_SERVER_OUTPUT_DIR=/app/outputs
ITDK_SNAPSHOT_ID=nids-itdk-mcp-synthetic-v1
