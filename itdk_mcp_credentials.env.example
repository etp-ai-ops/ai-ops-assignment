# Copy this file to itdk_mcp_credentials.env, replace the example key, and
# export the same values into the shell that starts Jupyter or Python clients.
MCP_MASTER_KEY=replace-with-a-long-random-classroom-key
MCP_PORT=8000
ITDK_MCP_URL=http://127.0.0.1:8000/mcp/sse
ITDK_OUTPUT_DIR=./outputs
ITDK_SERVER_OUTPUT_DIR=/app/outputs
ITDK_SNAPSHOT_ID=nids-itdk-mcp-synthetic-v1

# For Parts 2/3's graded work, point the MCP server at the real read-only
# teaching-snapshot DSN your instructor provides (the same database Part 1's
# db_credentials.env connects to directly), not the local fixture. Leave unset
# during development/testing to use the local synthetic fixture instead.
ITDK_DATABASE_URL=

# Parts 2 and 3 of the notebook run a client-side tool-calling loop against an
# OpenAI-compatible endpoint -- NRP Nautilus by default, so students aren't
# limited by needing their own Claude subscription/API key. Put your own key
# here (or export it in the shell that starts Jupyter). Never commit a real key.
OPENAI_API_KEY=replace-with-your-own-nrp-nautilus-api-key
OPENAI_BASE_URL=https://ellm.nrp-nautilus.io/v1
# The model the notebook's agent cells use. kimi is strongly recommended: in
# testing it was the most reliable of NRP Nautilus's models at this notebook's
# tool-calling pattern -- others (e.g. minimax-m2) have been observed going
# off-track (brute-force guessing at values no tool can look up) or truncating
# before a final answer. See the endpoint's /v1/models listing for the full
# catalog if you want to compare others.
ITDK_AGENT_MODEL=kimi
# The notebook's agent loop calls the MCP server itself, so ITDK_PUBLIC_MCP_URL
# only needs to be reachable from wherever Jupyter runs -- ITDK_MCP_URL usually
# suffices for a purely local server. Set this only if your deployment runs
# Jupyter somewhere that can't reach the local MCP server directly.
ITDK_PUBLIC_MCP_URL=
