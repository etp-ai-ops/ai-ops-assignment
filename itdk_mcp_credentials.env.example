# Copy this file to itdk_mcp_credentials.env, replace the example key, and
# export the same values into the shell that starts Jupyter or Python clients.
MCP_MASTER_KEY=replace-with-a-long-random-classroom-key
MCP_PORT=8000
ITDK_MCP_URL=http://127.0.0.1:8000/mcp/sse
ITDK_OUTPUT_DIR=./outputs
ITDK_SERVER_OUTPUT_DIR=/app/outputs
ITDK_SNAPSHOT_ID=nids-itdk-mcp-synthetic-v1

# Parts 2 and 3 of the notebook call the Anthropic Messages API with the
# remote-MCP connector pointed at ITDK_MCP_URL. Put your own key here (or
# export it in the shell that starts Jupyter). Never commit a real key.
ANTHROPIC_API_KEY=replace-with-your-own-anthropic-api-key
# Optional: the model the notebook's agent cells use.
ITDK_AGENT_MODEL=claude-opus-5
# The MCP connector runs server-side at Anthropic, so ITDK_MCP_URL must be a
# publicly reachable https:// URL. For a local server, set this to the public
# tunnel URL your course deployment provides.
ITDK_PUBLIC_MCP_URL=https://replace-with-the-publicly-reachable-sse-url/mcp/sse
