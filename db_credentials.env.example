## Copy this file to db_credentials.env (git-ignored) for Task 1 ONLY: hand
## SQL exploration of the local synthetic fixture started by
## `docker compose up -d`. This is a direct Postgres connection, separate
## from the MCP server's own itdk_mcp_credentials.env.example.
##
## itdk_reader is the same read-only role (`SELECT` on all four
## caida_itdk tables, default_transaction_read_only = on) already created in
## data/initdb/001_schema_fixture.sql -- no new role or SQL is required.
##
## IMPORTANT: this DSN reaches only the local synthetic fixture
## (nids-itdk-mcp-synthetic-v1) published by docker-compose.yml's `db`
## service on 127.0.0.1. It is never a path to the frozen graded ITDK
## snapshot -- Task 4's graded investigation must go through the MCP server
## only. Never point this DSN at a production or graded database.
db_host=127.0.0.1
db_port=5433
db_name=itdk_fixture

## itdk_reader is read-only and safe to share with students for local
## exploration against the fixture.
db_read_user=itdk_reader
db_read_password=fixture-reader-local-only
ITDK_READ_DSN=postgresql://${db_read_user}:${db_read_password}@${db_host}:${db_port}/${db_name}
