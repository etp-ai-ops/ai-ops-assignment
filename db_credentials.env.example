## Copy this file to db_credentials.env (git-ignored) for Part 1 ONLY: hand
## SQL exploration of the REAL ITDK teaching snapshot. This is a direct
## Postgres connection, separate from the MCP server's own
## itdk_mcp_credentials.env.example.
##
## Your instructor provides the real host/port/database/user/password below --
## the same way a prior CAIDA ITDK assignment's db_credentials.env was handed
## out. There is no working local fallback: nids-itdk-mcp.ipynb refuses to
## connect without a real ITDK_READ_DSN here or in the environment.
##
## IMPORTANT: this is real, access-controlled measurement data about real
## networks. Never commit the filled-in db_credentials.env, query results, or
## generated CSVs derived from it.
db_host=REPLACE_WITH_INSTRUCTOR_HOST
db_port=5432
db_name=REPLACE_WITH_INSTRUCTOR_DB_NAME

## The read-only role your instructor hands out.
db_read_user=REPLACE_WITH_READONLY_USER
db_read_password=REPLACE_WITH_READONLY_PASSWORD
ITDK_READ_DSN=postgresql://${db_read_user}:${db_read_password}@${db_host}:${db_port}/${db_name}
